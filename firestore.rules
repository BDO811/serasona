rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own profile + subscription state. The client may read its
    // own doc and update its own profile fields, but never write `subscription`
    // directly — that field is only ever written by the stripe-webhook Cloud
    // Function, which uses the Admin SDK and bypasses these rules entirely.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !("subscription" in request.resource.data);
      // biologicalSex is here so the check-in screen can remember which figure
      // to show. It is still an allowlist, and subscription is still absent
      // from it: the client must never be able to grant itself a plan.
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["email", "fullName", "biologicalSex"])
                    && (!("biologicalSex" in request.resource.data)
                        || request.resource.data.biologicalSex in ["male", "female"]);
      allow delete: if false;

      // Daily check-in history, owned entirely by the user it belongs to.
      match /checkins/{checkinId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // check-ins are append-only
      }
    }

    // Admin-only collections. The catch-all below already denies these, but
    // they are called out explicitly because the cost of someone later adding a
    // broad rule above the catch-all is a leaked TOTP secret or a forged
    // elevation grant. Only the Admin SDK touches these, and it bypasses rules.
    //
    //   adminTotp      per-admin TOTP secrets
    //   adminElevation live second-factor grants (hashed)
    //   adminAudit     append-only record of every admin action
    //   voiceSessions  every user's check-in history
    match /adminTotp/{doc}      { allow read, write: if false; }
    match /adminElevation/{doc} { allow read, write: if false; }
    match /adminAudit/{doc}     { allow read, write: if false; }
    match /voiceSessions/{doc}  { allow read, write: if false; }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
